{
  "name": "sendora-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sendora - Premium Temporary Cloud File Sharing SaaS",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
