{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendora-worker",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendora-db",
      "database_id": "sendora-d1-placeholder"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sendora-storage"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "MAX_FILE_SIZE_BYTES": 209715200,
    "DEFAULT_EXPIRATION_HOURS": 24,
    "APP_BASE_URL": "http://localhost:5173",
    "R2_ACCOUNT_ID": "",
    "R2_ACCESS_KEY_ID": "",
    "R2_SECRET_ACCESS_KEY": "",
    "R2_BUCKET_NAME": "sendora-storage"
  }
}

