{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendora-worker",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendora-db",
      "database_id": "b38a703c-7ef0-404c-8662-433861f49e2a"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SENDORA_STORAGE",
      "id": "bd658d30783e423487cf658cc9d23fd8"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "MAX_FILE_SIZE_BYTES": 209715200,
    "DEFAULT_EXPIRATION_HOURS": 24,
    "APP_BASE_URL": "http://localhost:5173",
    "R2_ACCOUNT_ID": "",
    "R2_ACCESS_KEY_ID": "",
    "R2_SECRET_ACCESS_KEY": "",
    "R2_BUCKET_NAME": "sendora-storage"
  }
}

